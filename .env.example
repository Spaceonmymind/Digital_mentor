APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true
PRESENTATION_MODE=false

POSTGRES_DB=digital_mentor
POSTGRES_USER=digital_mentor
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://digital_mentor:change_me@db:5432/digital_mentor
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx

MOCK_ANALYSIS_ENABLED=true
MOCK_ANALYSIS_STEP_DELAY=1.5
CORS_ORIGINS=*

FRONTEND_MOCK_MODE=false
TTS_MODE=remote
TTS_MAX_TEXT_LENGTH=700
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=verse
TTS_SPEED=1.3
TTS_TIMEOUT_SECONDS=20
TTS_MAX_RETRIES=2

DOCUMENT_RETENTION_HOURS=24
AUDIO_RETENTION_MINUTES=60
REPORT_RETENTION_HOURS=24

POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
LLM_REQUEST_TIMEOUT_SECONDS=60

ANALYSIS_ENGINE=mock
AI_DOCUMENT_MAX_CHARS=60000
AI_DOCUMENT_EXCERPT_STRATEGY=head_tail
AI_WORKER_TEMPERATURE=0
AI_WORKER_MAX_COMPLETION_TOKENS=2000
AI_WORKER_SEED=42
AI_CRITIC_TEMPERATURE=0
AI_CRITIC_MAX_COMPLETION_TOKENS=4000
AI_FINAL_EXPERT_TEMPERATURE=0
AI_FINAL_EXPERT_MAX_COMPLETION_TOKENS=3000
AI_EXECUTION_STOP_ON_ERROR=true
AI_DEMO_AUTO_APPROVE_GATES=true
MENTOR_BLOCK_VISIBLE_TO_STUDENT=false
AI_ASSESSMENT_MAX_COST_RUB=100
AI_MAX_WORKER_CALLS=100
AI_MAX_CRITIC_CALLS=30
AI_MAX_FINAL_EXPERT_CALLS=1
