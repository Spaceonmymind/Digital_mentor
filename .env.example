APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true

POSTGRES_DB=digital_mentor
POSTGRES_USER=digital_mentor
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://digital_mentor:change_me@db:5432/digital_mentor
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx

MOCK_ANALYSIS_ENABLED=true
MOCK_ANALYSIS_STEP_DELAY=1.5
CORS_ORIGINS=*

FRONTEND_MOCK_MODE=false
TTS_MODE=browser
TTS_MAX_TEXT_LENGTH=700

DOCUMENT_RETENTION_HOURS=24
AUDIO_RETENTION_MINUTES=60
REPORT_RETENTION_HOURS=24
